{
  "name": "growchat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "pnpm exec tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "deploy": "pnpm run build:css && wrangler deploy",
    "dev": "PORT=${GROWCHAT_PORT:-8787} && node scripts/ensure-port.js $PORT && pnpm run build:css && node scripts/init-local-db.js && wrangler dev --ip 0.0.0.0 --port $PORT -- --log-level debug",
    "dev:db": "node scripts/init-local-db.js",
    "dev:remote": "PORT=${GROWCHAT_PORT:-8787} && node scripts/ensure-port.js $PORT && pnpm run build:css && wrangler dev --remote --ip 0.0.0.0 --port $PORT -- --log-level debug",
    "setup": "node scripts/setup-wizard.js",
    "predeploy": "node scripts/pre-deploy.js",
    "generate:api-docs": "node scripts/generate-api-docs.js",
    "validate:migrations": "node scripts/validate-migrations.js",
    "snapshots:clean": "node scripts/cleanup-snapshots.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scoped": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/test-e2e.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "node scripts/test-e2e.js --update-snapshots",
    "lint": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --ignore-pattern node_modules",
    "lint:fix": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/js/**/*.js\"",
    "typecheck": "tsc -p tsconfig.guardrails.json --noEmit",
    "lint:dupes": "node scripts/fallow-dupes-gate.js 1",
    "lint:dupes:budget": "node scripts/fallow-dupes-gate.js 1",
    "lint:dupes:scoped": "node scripts/fallow-dupes-gate.js --changed-since HEAD 1",
    "lint:hygiene": "fallow dead-code --format json --fail-on-issues",
    "lint:security": "fallow security --format json --changed-since HEAD --gate new --fail-on-issues",
    "lint:flags": "node scripts/fallow-flags-gate.js",
    "lint:security:scoped": "fallow security --changed-since HEAD~1 --format json --gate new --fail-on-issues",
    "lint:flags:scoped": "node scripts/fallow-flags-gate.js --changed-since HEAD~1",
    "lint:all": "fallow audit --changed-since HEAD~1 --format json --fail-on-issues",
    "lint:all:scoped": "fallow audit --changed-since HEAD~1 --format json --fail-on-issues",
    "precommit": "node scripts/secret-scan.cjs && pnpm exec lint-staged",
    "prepush": "pnpm run typecheck && pnpm run format:check && pnpm run lint:hygiene && pnpm run lint:dupes && pnpm run lint:security && pnpm run lint:flags",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.2.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "fallow": "^2.104.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.5",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.10",
    "wrangler": "^4.75.0"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
