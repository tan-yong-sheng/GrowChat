{
  "name": "growchat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "pnpm exec tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "deploy": "pnpm run build:css && wrangler deploy",
    "dev": "PORT=${GROWCHAT_PORT:-8787} && node scripts/ensure-port.js $PORT && pnpm run build:css && node scripts/init-local-db.js && wrangler dev --ip 0.0.0.0 --port $PORT -- --log-level debug",
    "dev:db": "node scripts/init-local-db.js",
    "dev:remote": "PORT=${GROWCHAT_PORT:-8787} && node scripts/ensure-port.js $PORT && pnpm run build:css && wrangler dev --remote --ip 0.0.0.0 --port $PORT -- --log-level debug",
    "setup": "node scripts/setup-wizard.js",
    "predeploy": "node scripts/pre-deploy.js",
    "generate:api-docs": "node scripts/generate-api-docs.js",
    "validate:migrations": "node scripts/validate-migrations.js",
    "check:mutation": "stryker run",
    "snapshots:clean": "node scripts/cleanup-snapshots.js",
    "snapshots:audit": "node scripts/audit-snapshots.js .",
    "check:performance": "lhci autorun",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scoped": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/test-e2e.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "node scripts/test-e2e.js --update-snapshots",
    "lint": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --ignore-pattern node_modules",
    "lint:fix": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check:scoped": "node scripts/run-scoped-guardrails.js --prettier",
    "arch:check": "depcruise src public/js --config .dependency-cruiser.cjs",
    "arch:check:scoped": "node scripts/run-scoped-guardrails.js --depcruise",
    "arch:graph": "depcruise src public/js --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/architecture-graph.svg",
    "typecheck": "tsc -p tsconfig.guardrails.json --noEmit",
    "setup:semgrep": "uv tool install semgrep",
    "lint:logic": "semgrep scan --config .semgrep/rules.yml",
    "lint:logic:scoped": "node scripts/run-scoped-guardrails.js --semgrep",
    "lint:dupes": "node scripts/fallow-dupes-gate.js 1",
    "lint:dupes:budget": "node scripts/fallow-dupes-gate.js 1",
    "lint:dupes:scoped": "node scripts/fallow-dupes-gate.js --changed-since HEAD 1",
    "lint:design": "npx @google/design.md lint DESIGN.md",
    "lint:hygiene": "fallow dead-code --baseline .fallow/baseline.json --format json --fail-on-issues",
    "lint:health": "fallow health --format json --fail-on-issues",
    "lint:security": "fallow security --format json --fail-on-issues",
    "lint:flags": "node scripts/fallow-flags-gate.js",
    "lint:health:scoped": "fallow health --changed-since HEAD~1 --format json --report-only",
    "lint:security:scoped": "fallow security --changed-since HEAD~1 --format json --gate new --fail-on-issues",
    "lint:flags:scoped": "node scripts/fallow-flags-gate.js --changed-since HEAD~1",
    "lint:all": "fallow audit --changed-since HEAD~1 --format json --fail-on-issues",
    "lint:all:scoped": "fallow audit --changed-since HEAD~1 --format json --fail-on-issues",
    "lint:workflows": "github-actionlint",
    "precommit": "node scripts/secret-scan.cjs && pnpm exec lint-staged",
    "prepush": "pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run lint:logic && pnpm run lint:dupes && pnpm run lint:dupes:budget && pnpm run lint:health && pnpm run lint:security && pnpm run lint:flags && pnpm run arch:check && pnpm run format:check && pnpm run lint:hygiene && pnpm run test:e2e",
    "prepare": "husky",
    "prepush:scoped": "pnpm run test:scoped && pnpm run typecheck && pnpm run lint && pnpm run lint:logic:scoped && pnpm run lint:dupes:scoped && pnpm run lint:dupes:budget && pnpm run lint:health:scoped && pnpm run lint:security:scoped && pnpm run lint:flags:scoped && pnpm run arch:check:scoped && pnpm run format:check:scoped && pnpm run lint:hygiene && pnpm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/cli": "^2.31.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "commitlint": "^20.5.2",
    "danger": "^13.0.7",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "fallow": "^2.104.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.5",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.10",
    "wrangler": "^4.75.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
