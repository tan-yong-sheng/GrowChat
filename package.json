{
  "name": "growchat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "pnpm exec tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "deploy": "pnpm run build:css && wrangler deploy",
    "dev": "PORT=${GROWCHAT_PORT:-8787} && node scripts/ensure-port.js $PORT && pnpm run build:css && node scripts/init-local-db.js && wrangler dev --ip 0.0.0.0 --port $PORT -- --log-level debug",
    "dev:db": "node scripts/init-local-db.js",
    "dev:remote": "PORT=${GROWCHAT_PORT:-8787} && node scripts/ensure-port.js $PORT && pnpm run build:css && wrangler dev --remote --ip 0.0.0.0 --port $PORT -- --log-level debug",
    "predeploy": "node scripts/pre-deploy.js",
    "generate:api-docs": "node scripts/generate-api-docs.js",
    "validate:migrations": "node scripts/validate-migrations.js",
    "check:mutation": "stryker run",
    "snapshots:clean": "node scripts/cleanup-snapshots.js",
    "snapshots:audit": "node scripts/audit-snapshots.js .",
    "check:performance": "lhci autorun",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/test-e2e.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "lint": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --ignore-pattern node_modules",
    "lint:fix": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check:scoped": "node scripts/run-scoped-guardrails.js --prettier",
    "arch:check": "depcruise src public/js --config .dependency-cruiser.cjs",
    "arch:check:scoped": "node scripts/run-scoped-guardrails.js --depcruise",
    "arch:graph": "depcruise src public/js --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/architecture-graph.svg",
    "typecheck": "tsc -p tsconfig.guardrails.json --noEmit",
    "setup:semgrep": "uv tool install semgrep",
    "lint:logic": "semgrep scan --config .semgrep/rules.yml",
    "lint:logic:scoped": "node scripts/run-scoped-guardrails.js --semgrep",
    "lint:dupes": "jscpd public/js",
    "lint:dupes:budget": "node scripts/check-jscpd-budgets.js",
    "lint:dupes:scoped": "node scripts/run-scoped-guardrails.js --jscpd",
    "lint:design": "npx @google/design.md lint DESIGN.md",
    "lint:hygiene": "pnpm exec knip --include files,dependencies,binaries",
    "lint:workflows": "github-actionlint",
    "precommit": "node scripts/secret-scan.cjs && pnpm exec lint-staged",
    "prepush": "bash scripts/prepush-e2e.sh && pnpm run typecheck && pnpm run lint && pnpm run lint:logic:scoped && pnpm run lint:dupes:scoped && pnpm run lint:dupes:budget && pnpm run arch:check:scoped && pnpm run format:check:scoped && pnpm run lint:hygiene",
    "prepare": "husky",
    "prepush:checks": "pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run lint:logic:scoped && pnpm run lint:dupes:scoped && pnpm run lint:dupes:budget && pnpm run arch:check:scoped && pnpm run format:check:scoped && pnpm run lint:hygiene"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/cli": "^2.31.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "commitlint": "^20.5.2",
    "danger": "^13.0.7",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "jsdom": "^29.0.1",
    "knip": "^5.68.0",
    "lint-staged": "^16.4.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.10",
    "wrangler": "^4.75.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "ecc-universal": "^1.9.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
