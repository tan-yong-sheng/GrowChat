{
  "name": "growchat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "deploy": "npm run build:css && wrangler deploy",
    "dev": "npm run build:css && node scripts/init-local-db.js && wrangler dev --ip 0.0.0.0 -- --log-level debug",
    "dev:db": "node scripts/init-local-db.js",
    "dev:remote": "npm run build:css && wrangler dev --remote --ip 0.0.0.0 -- --log-level debug",
    "predeploy": "node scripts/pre-deploy.js",
    "generate:api-docs": "node scripts/generate-api-docs.js",
    "validate:migrations": "node scripts/validate-migrations.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "lint": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --ignore-pattern node_modules",
    "lint:fix": "eslint \"src/**/*.js\" \"public/js/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"public/js/**/*.js\"",
    "format:check:scoped": "node scripts/run-scoped-guardrails.js --prettier",
    "arch:check": "depcruise src public/js --config .dependency-cruiser.cjs",
    "arch:check:scoped": "node scripts/run-scoped-guardrails.js --depcruise",
    "arch:graph": "depcruise src public/js --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/architecture-graph.svg",
    "typecheck": "tsc -p tsconfig.guardrails.json --noEmit",
    "setup:semgrep": "uv tool install semgrep",
    "lint:logic": "semgrep scan --config .semgrep/rules.yml",
    "lint:logic:scoped": "node scripts/run-scoped-guardrails.js --semgrep",
    "lint:hygiene": "knip --include files,dependencies,binaries"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "commitlint": "^20.5.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^5.68.0",
    "lint-staged": "^16.4.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.75.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "ecc-universal": "^1.9.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}
