# GrowChat Environment Variables
# Copy to .env and fill in your values

## OpenAI-compatible API (for PR-Agent and other AI tools)
# These configure PR-Agent (The-PR-Agent/pr-agent) for automated code review.
# Set in repo Settings > Secrets and variables > Actions:
#   - PR_AGENT_BASE_URL and PR_AGENT_MODEL/PR_AGENT_FALLBACK go in Variables
#   - PR_AGENT_API_KEY goes in Secrets
#
# PR_AGENT_BASE_URL = URL of your OpenAI-compatible endpoint for PR-Agent
PR_AGENT_BASE_URL=
# PR_AGENT_API_KEY = API key for the above endpoint
PR_AGENT_API_KEY=
# PR_AGENT_MODEL = Primary model for code review (default: gpt-5-mini)
PR_AGENT_MODEL=gpt-5-mini
# PR_AGENT_FALLBACK = Comma-separated fallbacks for when the primary is unavailable
PR_AGENT_FALLBACK=gpt-4o-mini,gpt-4.1-nano

## Legacy OpenAI-compatible vars (for other tools)
# Maintained for compatibility with existing tooling that uses these names.
#OPENAI_API_BASE=
#OPENAI_API_KEY=
#OPENAI_MODEL=

## Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

## Email Service Configuration
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
