import { test, expect } from '@playwright/test';

test.describe('Search Placeholder Text Contrast Verification', () => {
  test.beforeEach(async ({ page }) => {
    // Mock API responses for authenticated user
    await page.route('**/api/users/me**', (route) =>
      route.fulfill({
        status: 200,
        body: JSON.stringify({ user: { id: '1', name: 'Test User', email: 'test@example.com' } })
      })
    );

    await page.route('**/api/chats**', (route) =>
      route.fulfill({
        status: 200,
        body: JSON.stringify({ chats: [], has_more: false })
      })
    );
  });

  test('verify search placeholder text has improved contrast (gray-600)', async ({ page }, testInfo) => {
    // Navigate to the app
    await page.goto('/');

    // Wait for the page to load
    await page.waitForLoadState('networkidle');

    // Wait a bit for the app to initialize
    await page.waitForTimeout(1000);

    // Open search modal with Ctrl+K
    await page.keyboard.press('Control+K');

    // Wait for the search modal to appear with longer timeout
    await page.waitForSelector('#modal-search-input', { timeout: 10000 });

    // Get the search input element
    const searchInput = page.locator('#modal-search-input');

    // Verify the input exists
    await expect(searchInput).toBeVisible();

    // Verify the placeholder text is visible
    const placeholderText = await searchInput.getAttribute('placeholder');
    expect(placeholderText).toBe('Search chats...');

    // Check the class contains placeholder:text-gray-600
    const classList = await searchInput.getAttribute('class');
    console.log('Input classes:', classList);
    expect(classList).toContain('placeholder:text-gray-600');

    // Take a screenshot to visually verify contrast
    await page.screenshot({ path: testInfo.outputPath('search-placeholder-contrast.png') });

    // Verify the placeholder is readable by checking it's not too light
    // Gray-600 should be darker than gray-500
    const isContrastImproved = classList?.includes('placeholder:text-gray-600');
    expect(isContrastImproved).toBe(true);

    console.log('✓ Search placeholder text contrast verified: gray-600 applied');
  });

  test('verify search modal opens and placeholder is visible', async ({ page }) => {
    await page.goto('/');
    await page.waitForLoadState('networkidle');
    await page.waitForTimeout(1000);

    // Open search modal
    await page.keyboard.press('Control+K');
    await page.waitForSelector('#modal-search-input', { timeout: 10000 });

    const searchInput = page.locator('#modal-search-input');
    await expect(searchInput).toBeVisible();

    // Verify placeholder text is readable (not grayed out too much)
    const boundingBox = await searchInput.boundingBox();
    expect(boundingBox).not.toBeNull();

    // Take a close-up screenshot of the search input
    await searchInput.screenshot({ path: testInfo.outputPath('search-input-closeup.png') });

    console.log('✓ Search modal placeholder is visible and readable');
  });
});
