# GrowChat local development environment variables
# Copy this file to .dev.vars and fill in the values.
#
#   cp .dev.vars.example .dev.vars
#
# These are used by `wrangler dev` for local development only.
# Production secrets are set via: pnpm exec wrangler secret put <NAME>

# Required: JWT secret for signing auth tokens
JWT_SECRET=change-me-to-a-random-string

# Optional: Resend API key for transactional emails (password reset)
# RESEND_API_KEY=re_xxxxx

# Optional: From email address for Resend
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: Default LLM model (falls back to Workers AI if not set)
# DEFAULT_MODEL=gpt-4
